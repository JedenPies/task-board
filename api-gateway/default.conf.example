server {
    listen 80;
    server_name localhost;

    error_page 502 503 504 /50x.html;

    resolver 127.0.0.11 valid=30s;

    location = /50x.html {
        root /usr/share/nginx/html;
        internal;
    }

    location / {
        set $frontend http://task-board-frontend:80;
        proxy_pass $frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location ~ ^/api/(authentication|users) {
        set $auth http://task-board-auth:8080;
        proxy_pass $auth;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/task-boards {
        set $backend http://task-board-backend:8081;
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # KLUCZOWE DLA SSE (Server-Sent Events):
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
    }
}